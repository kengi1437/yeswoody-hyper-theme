{% liquid
  assign tab_count = block.blocks.size
  assign tab_style = section.settings.tab_style
  assign products_limit = section.settings.products_per_tab
%}

<div class="collection-tabs-wrapper" {{ block.shopify_attributes }} style="--columns: {{ section.settings.columns }}; --mobile-columns: {{ section.settings.mobile_columns }};">
  {% if tab_count > 0 %}
    {%- comment -%} Tab Navigation {%- endcomment -%}
    <div class="collection-tabs__nav collection-tabs__nav--{{ tab_style }}">
      {% for tab_block in block.blocks %}
        {% liquid
          assign collection = tab_block.settings.collection
          if collection != blank
            assign tab_title = collection.title
          else
            assign tab_title = tab_block.settings.tab_title | default: 'Collection'
          endif
          
          if forloop.first
            assign is_active = 'is-active'
          else
            assign is_active = ''
          endif
        %}
        <button 
          class="collection-tabs__tab {{ is_active }}"
          data-tab-index="{{ forloop.index0 }}"
          type="button"
        >
          {{ tab_title }}
        </button>
      {% endfor %}
    </div>

    {%- comment -%} Tab Panels {%- endcomment -%}
    <div class="collection-tabs__panels">
      {% for tab_block in block.blocks %}
        {% liquid
          assign collection = tab_block.settings.collection
          
          if forloop.first
            assign is_active = 'is-active'
            assign is_hidden = ''
          else
            assign is_active = ''
            assign is_hidden = 'hidden'
          endif
        %}
        
        <div 
          class="collection-tabs__panel {{ is_active }}"
          data-panel-index="{{ forloop.index0 }}"
          {{ is_hidden }}
        >
          {% if collection != blank and collection.products.size > 0 %}
            <div class="collection-tabs__products">
              {% for product in collection.products limit: products_limit %}
                {% render 'product-card-simple', 
                  product: product,
                  columns: section.settings.columns,
                  mobile_columns: section.settings.mobile_columns
                %}
              {% endfor %}
            </div>
            
            {% if collection.products.size > products_limit %}
              <div class="collection-tabs__view-all">
                <a href="{{ collection.url }}" class="button">
                  View all {{ collection.title }}
                </a>
              </div>
            {% endif %}
          {% else %}
            <div class="collection-tabs__empty">
              <p>No products found in this collection.</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-tabs__empty">
      <p>Add collection tabs to display products.</p>
    </div>
  {% endif %}
</div>

<script>
  class CollectionTabs extends HTMLElement {
    constructor() {
      super();
      this.init();
    }

    init() {
      const tabs = this.querySelectorAll('.collection-tabs__tab');
      const panels = this.querySelectorAll('.collection-tabs__panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const tabIndex = tab.dataset.tabIndex;

          // Remove active from all tabs and panels
          tabs.forEach(t => t.classList.remove('is-active'));
          panels.forEach(p => {
            p.classList.remove('is-active');
            p.setAttribute('hidden', '');
          });

          // Add active to clicked tab and corresponding panel
          tab.classList.add('is-active');
          const activePanel = this.querySelector(`[data-panel-index="${tabIndex}"]`);
          if (activePanel) {
            activePanel.classList.add('is-active');
            activePanel.removeAttribute('hidden');
          }
        });
      });
    }
  }

  if (!customElements.get('collection-tabs')) {
    customElements.define('collection-tabs', CollectionTabs);
  }

  // Initialize immediately for existing elements
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.collection-tabs-wrapper').forEach(el => {
      if (!el.querySelector('.collection-tabs__tab[data-initialized]')) {
        el.closest('collection-tabs')?.init?.();
      }
    });
  });
</script>

{% stylesheet %}
  .collection-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 32px;
  }

  /* Pills style */
  .collection-tabs__nav--pills .collection-tabs__tab {
    padding: 10px 24px;
    border: none;
    border-radius: 50px;
    background: var(--color-secondary-background, #f5f5f5);
    color: var(--color-foreground, #000);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .collection-tabs__nav--pills .collection-tabs__tab.is-active,
  .collection-tabs__nav--pills .collection-tabs__tab:hover {
    background: var(--color-button, #000);
    color: var(--color-button-text, #fff);
  }

  /* Underline style */
  .collection-tabs__nav--underline .collection-tabs__tab {
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-foreground, #000);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .collection-tabs__nav--underline .collection-tabs__tab.is-active,
  .collection-tabs__nav--underline .collection-tabs__tab:hover {
    border-bottom-color: var(--color-button, #000);
  }

  /* Buttons style */
  .collection-tabs__nav--buttons .collection-tabs__tab {
    padding: 12px 28px;
    border: 2px solid var(--color-button, #000);
    border-radius: var(--buttons-radius, 8px);
    background: transparent;
    color: var(--color-button, #000);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .collection-tabs__nav--buttons .collection-tabs__tab.is-active,
  .collection-tabs__nav--buttons .collection-tabs__tab:hover {
    background: var(--color-button, #000);
    color: var(--color-button-text, #fff);
  }

  .collection-tabs__panels {
    position: relative;
  }

  .collection-tabs__panel {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .collection-tabs__panel[hidden] {
    display: none;
    opacity: 0;
  }

  .collection-tabs__products {
    display: grid;
    grid-template-columns: repeat(var(--mobile-columns, 2), 1fr);
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .collection-tabs__products {
      grid-template-columns: repeat(var(--columns, 4), 1fr);
    }
  }

  .collection-tabs__view-all {
    margin-top: 32px;
    text-align: center;
  }

  .collection-tabs__empty {
    text-align: center;
    padding: 48px 24px;
    color: var(--color-subtext, #666);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Tabs Content",
  "blocks": [
    {
      "type": "_collection-tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "tab_title",
          "label": "Custom tab title",
          "info": "Leave blank to use collection title"
        }
      ]
    }
  ],
  "tag": "collection-tabs",
  "settings": [],
  "presets": [
    {
      "name": "Collection Tabs Content"
    }
  ]
}
{% endschema %}
