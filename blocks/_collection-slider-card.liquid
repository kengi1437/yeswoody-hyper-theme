{% liquid
  assign collection = block.settings.collection
  assign image = block.settings.image
  assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
  
  if collection == blank and image == blank
    assign placeholder = true
  else
    assign placeholder = false
  endif

  if collection != blank
    assign collection_url = collection.url
    assign collection_title = collection.title
    assign collection_image = collection.featured_image | default: collection.products.first.featured_image
  else
    assign collection_url = '#'
    assign collection_title = block.settings.title
    assign collection_image = image
  endif
%}

<div class="collection-card" {{ block.shopify_attributes }}>
  <a 
    href="{{ collection_url }}" 
    class="collection-card__link"
    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
  >
    <div class="collection-card__image-wrapper">
      {% if collection_image != blank %}
        <img
          src="{{ collection_image | image_url: width: 800 }}"
          srcset="
            {{ collection_image | image_url: width: 400 }} 400w,
            {{ collection_image | image_url: width: 600 }} 600w,
            {{ collection_image | image_url: width: 800 }} 800w
          "
          sizes="(min-width: 750px) calc(100vw / {{ section.settings.columns }}), calc(100vw / {{ section.settings.mobile_columns }})"
          alt="{{ collection_title | escape }}"
          loading="lazy"
          class="collection-card__image"
        >
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
      {% endif %}
      
      {% if block.settings.show_overlay %}
        <div class="collection-card__overlay" style="opacity: {{ overlay_opacity }};"></div>
      {% endif %}
    </div>
    
    <div class="collection-card__info">
      <h3 class="collection-card__title">{{ collection_title }}</h3>
      {% if block.settings.show_product_count and collection != blank %}
        <p class="collection-card__count">{{ collection.products_count }} {{ 'collections.general.items_with_count' | t: count: collection.products_count }}</p>
      {% endif %}
    </div>
  </a>
</div>

{% stylesheet %}
  .collection-card {
    position: relative;
    display: block;
  }

  .collection-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .collection-card__link:hover {
    transform: translateY(-4px);
  }

  .collection-card__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--blocks-radius, 8px);
    aspect-ratio: var(--collection-card-ratio, 1);
    background-color: var(--color-background, #f5f5f5);
  }

  .collection-card__image,
  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .collection-card__link:hover .collection-card__image {
    transform: scale(1.05);
  }

  .collection-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, transparent 40%, rgba(0, 0, 0, 0.6));
    pointer-events: none;
  }

  .collection-card__info {
    margin-top: 12px;
    text-align: center;
  }

  .collection-card__title {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
  }

  .collection-card__count {
    font-size: 0.9rem;
    color: var(--color-subtext, #666);
    margin: 4px 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Card",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom title",
      "info": "Used if no collection is selected"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Collection Card"
    }
  ]
}
{% endschema %}
