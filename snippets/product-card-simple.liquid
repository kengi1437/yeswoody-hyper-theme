{% comment %}
  Simple product card for collection tabs and grid layouts
  
  Usage:
  {% render 'product-card-simple', product: product, columns: 4, mobile_columns: 2 %}
{% endcomment %}

{% liquid
  assign product_url = product.url
  assign product_title = product.title
  assign product_image = product.featured_image
  assign product_price = product.price
  assign product_compare_price = product.compare_at_price
  assign on_sale = false
  if product_compare_price > product_price
    assign on_sale = true
  endif
  
  assign columns = columns | default: 4
  assign mobile_columns = mobile_columns | default: 2
%}

<div class="product-card-simple" data-product-id="{{ product.id }}">
  <a href="{{ product_url }}" class="product-card-simple__link">
    <div class="product-card-simple__image-wrapper">
      {% if product_image != blank %}
        <img
          src="{{ product_image | image_url: width: 600 }}"
          srcset="
            {{ product_image | image_url: width: 400 }} 400w,
            {{ product_image | image_url: width: 600 }} 600w,
            {{ product_image | image_url: width: 800 }} 800w
          "
          sizes="(min-width: 750px) calc(100vw / {{ columns }}), calc(100vw / {{ mobile_columns }})"
          alt="{{ product_title | escape }}"
          loading="lazy"
          class="product-card-simple__image"
        >
        
        {%- comment -%} Second image on hover {%- endcomment -%}
        {% if product.images.size > 1 %}
          <img
            src="{{ product.images[1] | image_url: width: 600 }}"
            alt="{{ product_title | escape }}"
            loading="lazy"
            class="product-card-simple__image product-card-simple__image--hover"
          >
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card-simple__placeholder' }}
      {% endif %}

      {% if on_sale %}
        <span class="product-card-simple__badge product-card-simple__badge--sale">Sale</span>
      {% endif %}

      {% unless product.available %}
        <span class="product-card-simple__badge product-card-simple__badge--sold-out">Sold out</span>
      {% endunless %}
    </div>

    <div class="product-card-simple__info">
      <h3 class="product-card-simple__title">{{ product_title }}</h3>
      
      <div class="product-card-simple__price">
        {% if on_sale %}
          <span class="product-card-simple__price-compare">{{ product_compare_price | money }}</span>
          <span class="product-card-simple__price-sale">{{ product_price | money }}</span>
        {% else %}
          <span class="product-card-simple__price-regular">{{ product_price | money }}</span>
        {% endif %}
      </div>
    </div>
  </a>
</div>

<style>
  .product-card-simple {
    position: relative;
    display: block;
  }

  .product-card-simple__link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .product-card-simple__link:hover {
    transform: translateY(-4px);
  }

  .product-card-simple__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--pcard-radius, 8px);
    aspect-ratio: 1;
    background-color: var(--color-secondary-background, #f5f5f5);
  }

  .product-card-simple__image,
  .product-card-simple__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card-simple__image--hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card-simple__link:hover .product-card-simple__image--hover {
    opacity: 1;
  }

  .product-card-simple__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 12px;
    border-radius: var(--badges-radius, 20px);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 1;
  }

  .product-card-simple__badge--sale {
    background-color: var(--color-badge-sale, #c4301c);
    color: var(--color-badge-sale-text, #fff);
  }

  .product-card-simple__badge--sold-out {
    background-color: var(--color-badge-soldout, #adadad);
    color: var(--color-badge-soldout-text, #fff);
  }

  .product-card-simple__info {
    margin-top: 12px;
  }

  .product-card-simple__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.4;
  }

  .product-card-simple__price {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-card-simple__price-regular,
  .product-card-simple__price-sale {
    font-size: 1rem;
    font-weight: 700;
  }

  .product-card-simple__price-sale {
    color: var(--color-product-price-sale, #c4301c);
  }

  .product-card-simple__price-compare {
    font-size: 0.9rem;
    text-decoration: line-through;
    color: var(--color-subtext, #666);
  }
</style>
