{%- liquid
  assign image = card_product.featured_media | default: card_product.featured_image
  assign second_image = card_product.media[1]
  assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: card_product.id
-%}

<div
  class="product-card product-card-style-{{ settings.product_card_style | default: 'standard' }} color-{{ settings.product_card_color_scheme | default: 'inherit' }}"
>
  <div class="product-card__wrapper h-full">
    <div class="product-card__image-wrapper color-scheme-1 bg-none">
      <a href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}" tabindex="-1">
        {%- if image != blank -%}
          <div
            class="media-wrapper product-card__image product-card__image--main"
            style="--aspect-ratio: {{ image.aspect_ratio | default: 1 }}"
          >
            {{ image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              widths: '165, 355, 450, 535, 710, 800',
              class: 'motion-reduce'
            }}
          </div>
          {%- if second_image != blank and settings.show_second_image -%}
            <div
              class="media-wrapper product-card__image product-card__image--second inset-full hidden md:block"
              style="--aspect-ratio: {{ second_image.aspect_ratio | default: 1 }}"
            >
              {{ second_image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '165, 355, 450, 535, 710, 800',
                class: 'motion-reduce'
              }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="media-wrapper product-card__image product-card__image--main placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </a>

      {%- if settings.show_badges -%}
        <div class="product-card__badge">
          {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="f-badge f-badge--sale" aria-hidden="true">
              {{- 'products.product.on_sale' | t -}}
            </span>
          {%- endif -%}
          {%- unless card_product.available -%}
            <span class="f-badge f-badge--sold-out" aria-hidden="true">
              {{- 'products.product.sold_out' | t -}}
            </span>
          {%- endunless -%}
        </div>
      {%- endif -%}

      {%- if settings.show_flash_sale and card_product.selected_or_first_available_variant.inventory_quantity > 0 and card_product.selected_or_first_available_variant.inventory_quantity <= 10 -%}
        <div class="product-card__flash-sale absolute blocks-radius-md color-scheme-1">
          <div class="flash-sale flex items-center gap-2">
            {%- render 'icon-flash' -%}
            <span class="font-body-bold text-sm-extra">{{ 'products.product.selling_fast' | t }}</span>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="product-card__actions product-card__main-actions no-js-hidden">
      {%- if card_product.available -%}
        {%- if card_product.variants.size == 1 -%}
          <button
            type="button"
            class="product-card__atc product-card__action-button btn btn--white"
            data-product-id="{{ card_product.selected_or_first_available_variant.id }}"
            data-add-to-cart
            {% unless card_product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            <span class="btn__text flex gap-1 items-center">
              <span class="product-card__atc-icon product-card__action-icon inline-flex md:hidden">
                {%- render 'icon-cart' -%}
              </span>
              <span class="product-card__atc-text product-card__action-text">
                {{- 'products.product.add_to_cart' | t -}}
              </span>
            </span>
          </button>
        {%- else -%}
          <button
            type="button"
            {% if settings.quick_view_enable %}
              aria-controls="QuickView-{{ card_product.id }}-{{ section.id }}"
              aria-haspopup="dialog"
            {% endif %}
            class="product-card__atc product-card__action-button btn btn--white"
          >
            <span class="btn__text flex gap-1 items-center">
              <span class="product-card__atc-icon product-card__action-icon inline-flex md:hidden">
                {%- render 'icon-cart' -%}
              </span>
              <span class="product-card__atc-text product-card__action-text">
                {{- 'products.product.view' | t -}}
              </span>
            </span>
          </button>
        {%- endif -%}
      {%- else -%}
        <a href="{{ card_product.url }}" class="product-card__atc product-card__action-button btn btn--white">
          <span class="btn__text flex gap-1 items-center">
            <span class="product-card__atc-text product-card__action-text">
              {{- 'products.product.view' | t -}}
            </span>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="product-card__info text-left">
      <h3 class="product-card__title text-pcard-title">
        <a class="reversed-link block" href="{{ card_product.url }}">
          <span class="reversed-link__text">{{ card_product.title | escape }}</span>
        </a>
      </h3>

      {%- render 'price', product: card_product, use_variant: true, price_class: 'product-card__price' -%}

      {%- if settings.show_color_swatches and card_product.has_only_default_variant == false -%}
        {%- render 'color-swatches', product: card_product -%}
      {%- endif -%}
    </div>

    <div class="product-card__list-actions hidden gap-3 flex-col">
      <div class="product-card__list-actions-main">
        {%- if card_product.available -%}
          {%- if card_product.variants.size == 1 -%}
            <button
              type="button"
              class="product-card__list-atc btn btn--primary"
              data-product-id="{{ card_product.selected_or_first_available_variant.id }}"
              data-add-to-cart
            >
              <span class="btn__text flex gap-1 items-center">
                {{- 'products.product.add_to_cart' | t -}}
              </span>
            </button>
          {%- else -%}
            <a href="{{ card_product.url }}" class="product-card__list-atc btn btn--primary">
              <span class="btn__text flex gap-1 items-center">
                {{- 'products.product.view' | t -}}
              </span>
            </a>
          {%- endif -%}
        {%- else -%}
          <a href="{{ card_product.url }}" class="product-card__list-atc btn btn--primary">
            <span class="btn__text flex gap-1 items-center">
              {{- 'products.product.sold_out' | t -}}
            </span>
          </a>
        {%- endif -%}
      </div>
      <a href="{{ card_product.url }}" class="btn btn--secondary">
        <span class="btn__text flex gap-1 items-center">{{ 'products.product.view_details' | t }}</span>
      </a>
    </div>
  </div>
</div>
