{%- liquid
  assign article_image = card_article.image
  assign article_title = card_article.title | escape
-%}

<div class="article-card color-scheme-{{ settings.article_card_color_scheme | default: '1' }}">
  <div class="article-card__wrapper h-full">
    {%- if article_image != blank -%}
      <a href="{{ card_article.url }}" class="article-card__image-wrapper block" aria-label="{{ article_title }}">
        <div class="media-wrapper article-card__image" style="--aspect-ratio: {{ article_image.aspect_ratio | default: 1.78 }}">
          {{ article_image | image_url: width: 800 | image_tag:
            loading: 'lazy',
            widths: '165, 355, 535, 710, 800',
            class: 'motion-reduce'
          }}
        </div>
      </a>
    {%- endif -%}

    <div class="article-card__info">
      {%- if card_article.tags.size > 0 and settings.show_article_tags -%}
        <div class="article-card__tags flex flex-wrap gap-2">
          {%- for tag in card_article.tags limit: 3 -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-card__tag text-sm text-subtext">
              {{ tag }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <h3 class="article-card__title h4">
        <a href="{{ card_article.url }}" class="reversed-link">
          <span class="reversed-link__text">{{ article_title }}</span>
        </a>
      </h3>

      {%- if settings.show_article_excerpt and card_article.excerpt_or_body != blank -%}
        <p class="article-card__excerpt text-subtext">
          {{ card_article.excerpt_or_body | strip_html | truncatewords: 30 }}
        </p>
      {%- endif -%}

      <div class="article-card__meta flex items-center gap-4 text-sm text-subtext">
        {%- if settings.show_article_date -%}
          <span class="article-card__date">
            {{ card_article.published_at | date: '%B %d, %Y' }}
          </span>
        {%- endif -%}
        {%- if settings.show_article_author and card_article.author != blank -%}
          <span class="article-card__author">{{ card_article.author }}</span>
        {%- endif -%}
        {%- if card_article.comments_enabled? and card_article.comments_count > 0 -%}
          <span class="article-card__comments">
            {{ 'blogs.comments.with_count' | t: count: card_article.comments_count }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
