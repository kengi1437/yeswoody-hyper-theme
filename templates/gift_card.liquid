<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ 'gift_card.title' | t }}</title>
    <meta name="description" content="{{ 'gift_card.title' | t }}">
    {{ content_for_header }}
  </head>
  <body class="gift-card-page template-gift-card">
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      <div class="gift-card page-width page-width--fixed color-scheme-1">
        <div class="gift-card__wrapper text-center">
          <div class="gift-card__header">
            {%- if section.settings.logo != blank -%}
              <img
                src="{{ section.settings.logo | image_url: width: 200 }}"
                alt="{{ shop.name | escape }}"
                class="gift-card__logo"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                loading="lazy"
              >
            {%- else -%}
              <h1 class="h2">{{ shop.name }}</h1>
            {%- endif -%}
          </div>

          <div class="gift-card__content">
            <h1 class="gift-card__heading h2">{{ 'gift_card.title' | t }}</h1>

            {%- if gift_card.expired or gift_card.enabled == false -%}
              <p class="gift-card__expired">{{ 'gift_card.expired' | t }}</p>
            {%- else -%}
              <p class="gift-card__balance-label h4">
                {%- if gift_card.balance != gift_card.initial_value -%}
                  {{ 'gift_card.remaining_html' | t: balance: gift_card.balance | money }}
                {%- else -%}
                  {{ 'gift_card.initial_value_html' | t: value: gift_card.initial_value | money }}
                {%- endif -%}
              </p>

              {%- if gift_card.balance != gift_card.initial_value -%}
                <p class="gift-card__spent text-subtext">
                  {{ 'gift_card.spent_html' | t: spent: gift_card.initial_value | minus: gift_card.balance | money }}
                </p>
              {%- endif -%}
            {%- endif -%}

            <div class="gift-card__code-wrapper">
              <div class="gift-card__code flex items-center justify-center gap-4">
                <span class="gift-card__code-value text-center">{{ gift_card.code | format_code }}</span>
                <button class="btn btn--primary" data-copy-gift-card="{{ gift_card.code | format_code }}">
                  <span class="btn__text">{{ 'gift_card.copy_code' | t }}</span>
                </button>
              </div>
            </div>

            {%- if gift_card.pass_url -%}
              <div class="gift-card__apple-wallet mt-6">
                <a href="{{ gift_card.pass_url }}" class="apple-wallet-badge">
                  <img
                    src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                    width="120"
                    height="40"
                    alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                    loading="lazy"
                  >
                </a>
              </div>
            {%- endif -%}

            <div class="gift-card__actions mt-8 flex flex-wrap gap-4 justify-center">
              <a
                href="{{ shop.url }}"
                class="btn btn--primary"
                target="_blank"
                rel="noopener"
              >
                <span class="btn__text">{{ 'gift_card.shop_link' | t }}</span>
              </a>
              <button
                class="btn btn--secondary"
                onclick="window.print();"
              >
                <span class="btn__text">{{ 'gift_card.print' | t }}</span>
              </button>
            </div>
          </div>

          {%- if gift_card.expired == false and gift_card.enabled -%}
            <div class="gift-card__qr mt-8 flex justify-center" data-identifier="{{ gift_card.qr_identifier }}"></div>
          {%- endif -%}
        </div>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var copyButton = document.querySelector('[data-copy-gift-card]');
        if (copyButton) {
          copyButton.addEventListener('click', function () {
            var code = this.getAttribute('data-copy-gift-card');
            navigator.clipboard.writeText(code).then(function () {
              this.querySelector('.btn__text').textContent = '{{ 'gift_card.copied' | t }}';
              setTimeout(() => {
                this.querySelector('.btn__text').textContent = '{{ 'gift_card.copy_code' | t }}';
              }, 2000);
            }.bind(this));
          });
        }
      });
    </script>

    <style>
      .gift-card-page {
        background-color: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .gift-card__wrapper {
        padding: 4rem 2rem;
        max-width: 48rem;
        margin: 0 auto;
      }
      .gift-card__code-value {
        font-size: 2.4rem;
        font-weight: 700;
        letter-spacing: 0.2rem;
        padding: 1.2rem 2.4rem;
        border: 1px dashed rgb(var(--color-border));
        border-radius: 0.8rem;
        background: rgb(var(--color-secondary-background));
      }
    </style>
  </body>
</html>
