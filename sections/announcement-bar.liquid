{%- if section.settings.show_announcement -%}
<div
  class="topbar section--padding color-scheme-{{ section.settings.color_scheme }} page-width page-width--fixed"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="topbar__inner grid items-center">
    {%- if section.blocks.size > 0 -%}
      <div class="topbar__column topbar__left hidden lg:flex flex-wrap flex-col lg:flex-row items-center lg:justify-start text-center lg:text-left">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul class="topbar__menu flex flex-wrap items-center justify-center lg:justify-start">
                {%- for link in block.settings.menu.links -%}
                  <li class="topbar__menu-item">
                    <a href="{{ link.url }}" class="block reversed-link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <div class="topbar__text rte">
                {{ block.settings.text }}
              </div>
            {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    <div class="topbar__column topbar__center flex lg:flex flex-wrap flex-col lg:flex-row items-center lg:justify-center text-center lg:text-center">
      <div class="topbar__text rte">
        {{ section.settings.message }}
      </div>
    </div>
    
    <div class="topbar__column topbar__right hidden lg:flex flex-wrap flex-col lg:flex-row items-center lg:justify-end text-center lg:text-right">
      {%- if section.settings.show_country_selector -%}
        <div class="topbar__country flex items-center gap-4">
          {%- render 'localization-form' -%}
        </div>
      {%- endif -%}
      
      {%- if section.settings.show_social -%}
        {%- render 'social-icons' -%}
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "topbar-section z-31",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {"value": "1", "label": "Scheme 1"},
        {"value": "2", "label": "Scheme 2"},
        {"value": "inverse", "label": "Inverse"}
      ],
      "default": "2"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Announcement text",
      "default": "<p>✌🏼 Free Express Shipping on orders $500!</p>"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 60, "step": 1, "default": 12, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom", 
      "min": 0, "max": 60, "step": 1, "default": 12, "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}