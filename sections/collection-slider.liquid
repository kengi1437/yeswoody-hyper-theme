{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} section-collection-slider spacing-style gap-style"
  style="{% render 'spacing-style', settings: section.settings %}{% render 'gap-style', value: section.settings.gap %}"
  data-testid="collection-slider-section"
>
  {% content_for 'block', type: 'group', id: 'static-header' %}
  {% content_for 'block', type: '_coll-slider', id: 'static-slider-content' %}
</div>

{% schema %}
{
  "name": "Collection Slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}],
      "default": "2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [{"value": "page-width", "label": "Page width"}, {"value": "full-width", "label": "Full width"}],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Icon style",
      "options": [{"value": "none", "label": "None"}, {"value": "arrow", "label": "Arrow"}, {"value": "chevron", "label": "Chevron"}],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Icon shape",
      "options": [{"value": "none", "label": "None"}, {"value": "circle", "label": "Circle"}, {"value": "square", "label": "Square"}],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {"type": "group", "name": "Header"},
    {"type": "_coll-slider", "name": "Collection slider"}
  ],
  "presets": [
    {
      "name": "Collection Slider",
      "category": "Collection"
    }
  ]
}
{% endschema %}
