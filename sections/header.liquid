<link
  rel="stylesheet"
  href="{{ 'component-custom-card.css' | asset_url }}"
  media="print"
  fetchpriority="low"
  onload="this.media='all'"
>
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} {
    --logo-width: {{ section.settings.logo_width }}px;
    --logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
  }
  #shopify-section-{{ section.id }} .header__bottom {
    --section-padding-top: 0px;
    --section-padding-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .header__top {
    --section-padding-top: 20px;
    --section-padding-bottom: 20px;
  }
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .header__bottom {
      --section-padding-top: 0;
      --section-padding-bottom: 0;
    }
    #shopify-section-{{ section.id }} .header__top {
      --section-padding-top: 1.6rem;
      --section-padding-bottom: 1.6rem;
    }
  }
</style>

<header
  data-section-id="{{ section.id }}"
  class="header items-center color-scheme-{{ section.settings.color_scheme }} header--show-sperator-line"
  {% if section.settings.enable_sticky_header %}
    is="sticky-header" data-sticky-type="always"
    data-collapse-on-scroll="true"
  {% endif %}
>
  <div class="header__top header__top--logo-{{ section.settings.logo_position }} items-center relative section--padding page-width page-width--fixed">
    <div class="header__icons header__icons--left lg:justify-start z-1 lg:hidden no-js-hidden">
      <div class="header__buttons flex items-center">
        <button
          class="menu-drawer-button btn btn--inherit flex flex-col items-center justify-center lg:hidden"
          aria-controls="MenuDrawer"
          aria-label="{{ 'accessibility.toggle_menu' | t }}"
        >
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>

    <h1 class="header__logo flex justify-center items-center z-1">
      {%- if section.settings.enable_toggle_navigation -%}
        <button
          class="menu-drawer-button toggle-navigation-button btn btn--inherit flex-col items-center justify-center hidden lg:flex shrink-0"
          aria-label="{{ 'accessibility.toggle_menu' | t }}"
        >
          <span class="hamburger-line"></span>
        </button>
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="h3 relative flex header__logo--image">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          <img
            srcset="{{ section.settings.logo | image_url: width: section.settings.logo_width_mobile }} 1x, {{ section.settings.logo | image_url: width: section.settings.logo_width_mobile | times: 2 }} 2x"
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width_mobile }}"
            loading="eager"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            alt="{{ logo_alt }}"
            class="logo header__logo--mobile md:hidden"
          >
          <img
            srcset="{{ section.settings.logo | image_url: width: section.settings.logo_width }} 1x, {{ section.settings.logo | image_url: width: section.settings.logo_width | times: 2 }} 2x"
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            loading="eager"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            alt="{{ logo_alt }}"
            class="logo header__logo--desktop md:block hidden"
          >
        {%- else -%}
          <span class="h3">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </h1>

    <div class="header__search flex items-center z-2">
      <predictive-search class="block w-full search__form" data-search-recommendation-empty="false" data-results-limit="10">
        <div class="flex flex-col w-full h-full">
          <form action="{{ routes.search_url }}" method="get" role="search" id="PredictiveSearch-{{ section.id }}">
            <input type="hidden" name="options[prefix]" value="last">
            <div class="search__field relative flex items-center">
              <input
                id="SearchInput-{{ section.id }}"
                class="search__input form-control"
                type="search"
                name="q"
                placeholder="{{ 'general.search.placeholder' | t }}"
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              >
              <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'general.search.search' | t }}</label>
              <button type="reset" class="search__reset absolute flex items-center justify-center text-subtext" aria-label="{{ 'general.search.reset' | t }}">
                <span>{{ 'general.search.clear' | t }}</span>
              </button>
              <button type="submit" class="btn--inherit search__field-icon absolute search__icon-search flex items-center justify-center predictive-search-icon" aria-label="{{ 'general.search.search' | t }}">
                {%- render 'icon-search' -%}
              </button>
            </div>
          </form>
          <div class="search__content page-width v-scrollable hidden color-scheme-{{ section.settings.color_scheme }}">
            <div class="search_box search__recommendations flex flex-col md:flex-row gap-y-6">
              <div class="search__products-recommendation search__box-products flex flex-col flex-grow gap-5 lg:gap-6 order-last md:order-first">
                <h4 class="h4">{{ 'general.search.most_searched' | t }}</h4>
                <div class="swipe-mobile swipe-mobile--2-cols">
                  <div class="f-grid f-grid--gap-medium f-grid--row-gap-inherit swipe-mobile__inner">
                    {%- if predictive_search.performed -%}
                      {%- for product in predictive_search.resources.products limit: 10 -%}
                        {%- render 'product-card', product: product -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </predictive-search>
    </div>

    <div class="header__icons header__icons--right z-1">
      <div class="header__buttons flex items-center justify-end">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="account-button header__icon__custom flex items-center justify-center">
            {%- render 'icon-account' -%}
            <span class="visually-hidden">{{ 'customer.account.title' | t }}</span>
          </a>
        {%- endif -%}
        
        <a href="{{ routes.cart_url }}" class="cart-icon-button flex items-center justify-center relative" id="cart-icon-bubble">
          {%- render 'icon-cart' -%}
          <span class="visually-hidden">{{ 'sections.cart.title' | t }}</span>
          {%- if cart.item_count > 0 -%}
            <div class="cart-count-bubble">
              <span aria-hidden="true">{{ cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>

  {%- if section.settings.show_bottom_nav -%}
    <div class="header__bottom header__bottom--centered section--padding page-width page-width--fixed color-scheme-{{ section.settings.color_scheme }}">
      <nav class="header__inline-menu">
        <ul class="list-menu list-menu--inline flex flex-wrap items-center justify-center" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              {%- if link.links != blank -%}
                <details is="mega-menu-disclosure">
                  <summary class="z-2 font-navigation">
                    <span class="menu__item flex items-center relative">
                      <span class="flex items-center menu__item-text reversed-link">
                        {{ link.title }}
                        {%- render 'icon-caret' -%}
                      </span>
                    </span>
                  </summary>
                  <div class="mega-menu v-scrollable">
                    <div class="mega-menu__container color-scheme-{{ section.settings.color_scheme }}">
                      <div class="page-width mega-menu__wrapper">
                        <div class="mega-menu__list">
                          {%- for childlink in link.links -%}
                            <div class="mega-menu__column flex flex-col gap-8">
                              <div class="mega-menu__item">
                                <div class="mega-menu__item-wrapper">
                                  <a href="{{ childlink.url }}" class="h6 mega-menu__link mega-menu__link--top font-heading">{{ childlink.title }}</a>
                                  {%- if childlink.links != blank -%}
                                    <ul class="mega-menu__item-child text-subtext">
                                      {%- for grandchild in childlink.links -%}
                                        <li class="reversed-link">
                                          <a href="{{ grandchild.url }}" class="block mega-menu__link">
                                            <span class="reversed-link__text">{{ grandchild.title }}</span>
                                          </a>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  {%- endif -%}
                                </div>
                              </div>
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="menu__item flex items-center relative font-navigation">
                  <span class="reversed-link__text">{{ link.title }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  {%- endif -%}

  {%- render 'menu-drawer' -%}
</header>

<div class="fixed-overlay fixed-overlay--header-section z-10"></div>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  {%- if section.settings.logo -%}
    "logo": {{ section.settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
  {%- endif -%}
  "sameAs": [
    {{ settings.social_twitter_link | json }},
    {{ settings.social_facebook_link | json }},
    "",
    {{ settings.social_instagram_link | json }},
    {{ settings.social_tiktok_link | json }},
    "",
    "",
    {{ settings.social_youtube_link | json }},
    ""
  ],
  "url": {{ shop.url | append: routes.root_url | json }}
}
</script>
<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
    "query-input": "required name=search_term_string"
  },
  "url": {{ shop.url | append: routes.root_url | json }}
}
</script>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 50, "max": 400, "step": 5, "default": 120, "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile logo width",
      "min": 50, "max": 200, "step": 5, "default": 95, "unit": "px"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"}
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {"value": "1", "label": "Scheme 1"},
        {"value": "2", "label": "Scheme 2"},
        {"value": "inverse", "label": "Inverse"}
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_toggle_navigation",
      "label": "Enable toggle navigation button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_nav",
      "label": "Show bottom navigation",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}