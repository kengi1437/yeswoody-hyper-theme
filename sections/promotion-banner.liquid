{% comment %}Hyper Theme - Promotion Banner Section{% endcomment %}

<link href="{{ 'section-promotion-banner.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />

<div class="section" data-section-id="{{ section.id }}">
<link href="{{ 'section-promotion-banner.css?v=12575601613770185261754038225' | asset_url }}" rel="stylesheet" type="text/css" media="all" />
<div
  class="section section--padding page-width page-width--fixed"
  data-section="template--24624869605673__promotion_banner_VCkmzP"
  style="--section-padding-top: 40px;--section-padding-bottom: 0px;"
>
  <div class="promotion-banner color-scheme-3  blocks-radius relative"><div class="promotion-banner__inner promotion-banner__inner--horizontal rich-text rich-text--tight flex flex-col lg:flex-row lg:justify-between lg:text-left lg:items-center text-center items-center"><div class="block rich-text__subheading">
              <motion-element
                data-motion="fade-up"
                data-motion-delay="0"
                
                class="flex items-center gap-2"
              >
                

                <span class="text-subheading">
                  Flash Sale now on!
                </span>
              </motion-element></div><motion-element
                class="block promotion-banner__timer"
                data-motion-delay="50"
                data-motion="fade-up"
                
              >
                <link href="{{ 'component-countdown-timer.css?v=53559981252041490731753233309' | asset_url }}" rel="stylesheet" type="text/css" media="all" />
<script src="{{ 'countdown-timer.js?v=143239708233669442911753233309' | asset_url }}" defer="defer"></script><countdown-timer
  id="countdown-timer-timer_6FyFrY"
  class="countdown-timer hidden no-js-hidden block"
  data-type="evergreen"
  data-duration="every_month"
  data-due-date="2025/06/28 03:45 PM"
>
  <div class="countdown-timer__inner inline-flex items-center justify-center">
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__day h1 "
        data-timer-day
      >
        00
      </div></div>
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__hour h1 "
        data-timer-hour
      >
        00
      </div></div>
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__minute h1 "
        data-timer-minute
      >
        00
      </div></div>
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__sec h1 "
        data-timer-second
      >
        00
      </div></div>
  </div>
</countdown-timer>

              </motion-element><motion-element
              class="block rte rich-text__text text-base-text"
              data-motion="fade-up"
              data-motion-delay="100"
              
            >
              <p>Save on modern table office, <br/>best sellers + more</p>
            </motion-element><motion-element
                class="block promotion-banner__code"
                data-motion="fade-up"
                data-motion-delay="150"
                
              >
                <div
                  class="tooltip--manual"
                  data-tooltip
                  is="copy-to-clipboard"
                  data-copy-value="FLASH30"
                >
                  <span class="tooltip pointer-events-none">Copied</span>
                  


  <button
    class="btn btn--primary"
    
  >
    <span class="btn__text">Use Code: FLASH30</span>
    
  </button>


                </div>
              </motion-element></div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "Promotion Banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Promotion Banner"
    }
  ]
}
{% endschema %}
