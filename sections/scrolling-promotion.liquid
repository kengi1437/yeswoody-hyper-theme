{% comment %}Hyper Theme - Scrolling Promotion Section{% endcomment %}

<link href="{{ 'section-scrolling-promotion.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />

<div class="section" data-section-id="{{ section.id }}">
<style data-shopify>#shopify-section-template--24624869605673__scrolling_promotion_9Hng8m {
    --section-padding-top: 20px;
    --section-padding-bottom: 20px;
    --h-spacing: 16px;
    --h-spacing-mobile: 9.6px;
    --duration: 20.0s;
  }
  
